# Hidden directories at any depth (e.g. .omc, .claude-flow, .DS_Store dirs)
.*
**/.*

# Exceptions — tracked dotfiles and dirs that must stay
!.gitignore
!.claude-plugin
!.claude-plugin/**

# Git worktrees
.worktrees

# Service approval runtime state
.service-approval

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
