# Hidden directories at any depth (e.g. .omc, .claude-flow, .DS_Store dirs)
.*
**/.*

# Exceptions — tracked dotfiles and dirs that must stay
!.gitignore
!.claude-plugin
!.claude-plugin/**
!.github
!.github/**
!.vscode
!.vscode/**

# Local files (generated or machine-specific)
CLAUDE.md

# Terraform provider binaries and local state (large, machine-specific)
**/.terraform/
*.tfplan
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Git worktrees
.worktrees

# Smoke test — local-only validation scripts and skills (not part of plugin distribution)
scripts/smoke-*.py
scripts/smoke-*.sh
scripts/smoke-scan-inputs.sh
service-approval-plugin/skills/smoke-test/
service-approval-plugin/kiro/agents/smoke-*.md
.service-approval/smoke-test-*.md
.service-approval/controls/
.service-approval/state/
out/domains/

# Python cache
__pycache__/
*.pyc

# Node modules
node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*.log