{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "*"
      },
      "Action": "sts:AssumeRoleWithSAML"
    },
    {
      "Effect": "Deny",
      "Principal": {
        "Federated": "arn:aws:iam::111111111111:saml-provider/NotMyProvider"
      },
      "Action": "sts:AssumeRoleWithSAML"
    }
  ]
}
