        <mxCell id="p04" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EAFE;strokeColor=#8C4FFF;strokeWidth=2.5;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;fontColor=#232F3E;" value="04 — Map" vertex="1">
          <mxGeometry height="200" width="280" x="1380" y="171" as="geometry" />
        </mxCell>
        <mxCell id="p04sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontColor=#3B4A57;" value="Parse framework + create controls;&lt;br&gt;map objectives, then assemble.&lt;br&gt;Primary: AWS Threat Model.&lt;br&gt;Supplemental evidence is labelled.&lt;br&gt;Custom frameworks map directly." vertex="1">
