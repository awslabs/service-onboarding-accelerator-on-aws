          <mxGeometry height="200" width="280" x="740" y="171" as="geometry" />
        </mxCell>
        <mxCell id="p02sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontColor=#3B4A57;" value="4 sub-skills (parallel):&lt;br&gt;• mitigations • capabilities&lt;br&gt;• API surface • attack surface&lt;br&gt;Use the pinned model; verify&lt;br&gt;capabilities with AWS sources." vertex="1">
