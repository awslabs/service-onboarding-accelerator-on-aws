        <mxCell id="p06sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontColor=#3B4A57;" value="skill: summarize&lt;br&gt;&lt;br&gt;Coverage matrix, control&lt;br&gt;inventory." vertex="1">
