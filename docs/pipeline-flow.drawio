        </mxCell>
        <mxCell id="p06" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7F3;strokeColor=#E7157B;strokeWidth=2.5;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;fontColor=#232F3E;" value="06 — Summarize&#10;(terminal)" vertex="1">
          <mxGeometry height="200" width="160" x="2020" y="171" as="geometry" />
        </mxCell>
        <mxCell id="p06sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontColor=#3B4A57;" value="skill: summarize&lt;br&gt;&lt;br&gt;Coverage matrix, control&lt;br&gt;inventory." vertex="1">
          <mxGeometry height="100" width="140" x="2032" y="219" as="geometry" />
        </mxCell>
        <mxCell id="p06out" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#5A6B7B;fontStyle=2;" value="→ SUMMARY-&#10;   REPORT.md" vertex="1">
          <mxGeometry height="40" width="140" x="2032" y="323" as="geometry" />
        </mxCell>
        <mxCell id="deliverable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#3F8624;strokeWidth=3;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontColor=#232F3E;" value="Deliverable to customer&#10;&#10;Recommended security controls.&#10;The customer applies them themselves —&#10;the pipeline does not deploy, test, or&#10;attest against a live account." vertex="1">
          <mxGeometry height="160" width="320" x="2268" y="189" as="geometry" />
        </mxCell>
        <mxCell id="gates" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#5A6B7B;strokeWidth=2;fontSize=13;fontStyle=2;align=center;verticalAlign=middle;fontColor=#3B4A57;dashed=1;" value="Guardrails: pre-write + post-write + Stop checks · verified intake and immutable snapshot (P0) · source accounting and report disclosure (P14) · phase completeness, factual verification and artifact checks" vertex="1">
          <mxGeometry height="60" width="2080" x="160" y="452" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6B7B;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="300" width="720" x="840" y="573" as="geometry" />
        </mxCell>
        <mxCell id="legend_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;fontColor=#232F3E;" value="Legend / notes" vertex="1">
          <mxGeometry height="26" width="300" x="856" y="587" as="geometry" />
        </mxCell>
        <mxCell id="legend_body" parent="1" style="text;html=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#3B4A57;" value="• Intake fetches once. Every phase and offline resume use the same sealed snapshot.&lt;br&gt;  Missing/modified snapshots or unauthenticated receipts block active runs.&lt;br&gt;&lt;br&gt;• Research and Map sub-skills run in parallel where the client supports it.&lt;br&gt;  Preventive guidance uses recommend → reference-based authors → root-cause critic.&lt;br&gt;&lt;br&gt;• CCMv4 is the default. Custom objectives map directly to model-backed controls;&lt;br&gt;  CCM text similarity is advisory. MITRE MCP is optional (bundled ATT&amp;CK fallback).&lt;br&gt;&lt;br&gt;• Source defects are disclosed in the framework-map appendix. Retired runs move&lt;br&gt;  to _archive/; active runs always require current model and reporting checks." vertex="1">
          <mxGeometry height="244" width="690" x="856" y="617" as="geometry" />
        </mxCell>
        <mxCell id="meta" parent="1" style="text;html=1;fontSize=12;align=right;verticalAlign=middle;fontColor=#93A1AF;" value="Service Onboarding Accelerator · Intake + six phases · published-model workflow" vertex="1">
          <mxGeometry height="24" width="980" x="1660" y="1027" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
