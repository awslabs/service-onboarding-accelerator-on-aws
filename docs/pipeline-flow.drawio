          <mxGeometry height="200" width="280" x="1060" y="171" as="geometry" />
        </mxCell>
        <mxCell id="p03sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontColor=#3B4A57;" value="Verify research capabilities,&lt;br&gt;API parameters, condition keys,&lt;br&gt;and policy expressibility.&lt;br&gt;AWS MCPs by default;&lt;br&gt;documented web fallback." vertex="1">
          <mxGeometry height="104" width="248" x="1076" y="219" as="geometry" />
        </mxCell>
        <mxCell id="p03out" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#5A6B7B;fontStyle=2;" value="→ validated.json" vertex="1">
