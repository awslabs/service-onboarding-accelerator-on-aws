        <mxCell id="p04sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontColor=#3B4A57;" value="4 sub-skills:&#xa;parse-framework • generate-controls&#xa;• framework-mapping • assemble&#xa;Citation-gated, per-domain." vertex="1">
