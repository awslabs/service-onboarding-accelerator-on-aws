        <mxCell id="deliverable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#3F8624;strokeWidth=3;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontColor=#232F3E;" value="Deliverable to customer&#xa;&#xa;Recommended security controls.&#xa;The customer applies them themselves —&#xa;the pipeline does not deploy, test, or&#xa;attest against a live account." vertex="1">
          <mxGeometry height="160" width="320" x="2268" y="189" as="geometry" />
        </mxCell>
        <mxCell id="gates" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#5A6B7B;strokeWidth=2;fontSize=13;fontStyle=2;align=center;verticalAlign=middle;fontColor=#3B4A57;dashed=1;" value="Guardrails on every phase:  PostToolUse + Stop hooks · validate_pipeline_integrity (P1–P11) · check_phase_complete precondition gate · MCP-verified facts logged to pipeline.log · citation-gated mapping (AWS Threat Model → Control Catalog → service docs)" vertex="1">
          <mxGeometry height="60" width="2080" x="160" y="452" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6B7B;strokeWidth=1.5;" value="" vertex="1">
