        <mxCell id="p05" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#ED7100;strokeWidth=2.5;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;fontColor=#232F3E;" value="05 — Recommended Guidance" vertex="1">
          <mxGeometry height="200" width="280" x="1700" y="171" as="geometry" />
        </mxCell>
        <mxCell id="p05sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;fontColor=#3B4A57;" value="• Preventive: recommend → authors&lt;br&gt;  → critic (reference-anchored)&lt;br&gt;• Proactive rules&lt;br&gt;• Detective controls&lt;br&gt;• Responsive runbook references" vertex="1">
          <mxGeometry height="104" width="248" x="1716" y="219" as="geometry" />
        </mxCell>
        <mxCell id="p05out" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#5A6B7B;fontStyle=2;" value="→ 05-recommended-guidance/&#10;   {preventive,proactive,&#10;   detective,responsive}/" vertex="1">
