{
  "name": "service-approval",
  "version": "1.0.0",
  "description": "Generate AWS security controls and compliant IaC for any AWS service. Runs an 8-phase pipeline (Intake, Assess, Research, Validate, Map, Generate, Test, Summarize) mapped to CCMv4 / NIST 800-53 / CIS / ISO frameworks.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "aws-documentation": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "awsknowledge": {
      "httpUrl": "https://knowledge-mcp.global.api.aws"
    },
    "awsiac": {
      "command": "uvx",
      "args": [
        "awslabs.aws-iac-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:0.5.1"
      ]
    },
    "kb-search": {
      "command": "python3",
      "args": [
        "${extensionPath}/../tools/kb-search-mcp/server.py"
      ],
      "cwd": "${extensionPath}",
      "env": {
        "AWS_PROFILE": "delegated-admin",
        "AWS_REGION": "us-east-1"
      }
    },
    "iam": {
      "command": "uvx",
      "args": [
        "awslabs.iam-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "delegated-admin",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  },
  "excludeTools": [
    "run_shell_command(rm -rf)",
    "run_shell_command(sudo)"
  ]
}
