{
  "mcpServers": {
    "aws-documentation": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@1.1.28"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    },
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "iam": {
      "command": "uvx",
      "args": [
        "awslabs.iam-mcp-server@1.0.23"
      ],
      "env": {
        "AWS_PROFILE": "claude-code",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR",
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    },
    "mitre-attack": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/stoyky/mitre-attack-mcp@9ebd694bfc9869e81d5d1a3d3e7964e31a1e9087",
        "mitre-attack-mcp"
      ],
      "env": {
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
