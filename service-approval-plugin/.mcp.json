{
  "_comment": "Confirm exact URLs for aws-documentation and aws-cdk from https://github.com/awslabs/mcp before use in production. awsknowledge and awsiac URLs are proven from pace-spark.",
  "mcpServers": {
    "aws-documentation": {
      "type": "http",
      "url": "https://mcp.awsdocs.amazon.com"
    },
    "awsknowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "awsiac": {
      "type": "http",
      "url": "https://iac-mcp.global.api.aws"
    },
    "kb-search": {
      "command": "python3",
      "args": ["tools/kb-search-mcp/server.py"],
      "env": {
        "AWS_PROFILE": "delegated-admin",
        "AWS_REGION": "us-east-1"
      }
    },
    "terraform": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:0.5.1"]
    }
  }
}
