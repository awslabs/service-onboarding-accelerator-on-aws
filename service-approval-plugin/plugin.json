{
  "name": "service-approval",
  "version": "1.0.0",
  "description": "AWS service security controls generator — proactive, preventive, detective, remediation",
  "author": {
    "name": "GFS PACE",
    "email": "fsi-pace@amazon.com"
  },
  "skills": [
    "service-approval",
    "research",
    "validate",
    "generate",
    "test",
    "summarize"
  ],
  "includeMcpJson": true,
  "tools": ["*"],
  "resources": [],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 service-approval-plugin/tools/validate/hook_post_tool_use.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 service-approval-plugin/tools/validate/hook_stop.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
