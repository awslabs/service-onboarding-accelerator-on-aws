  "mitigations": [
    {
      "id": "6df5a224-53bf-5499-8fd8-ceb0e14e4928",
      "alias": "Mitigation.DSQL.1",
      "statement": "Aurora DSQL service API calls on a governed VPC network should only be made against trusted resources or AWS service-owned resources.",
      "mitigationContext": [
        {
          "type": "SCOPING",
          "context": "Attach a VPC endpoint policy to restrict access to trusted clusters and accounts.",
          "mitigationGoalId": "1953369d-27e3-42eb-aa78-cad921548bba"
        },
        {
          "type": "REFERENCE",
          "context": "Use aws:ResourceOrgID to scope access to your organization.",
          "links": [
            {
              "href": "https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies_data-perimeters.html#access_policies_data-perimeters-resource",
              "title": "Establishing a resource perimeter"
            }
          ]
        }
      ],
      "mappings": [
        {"type": "ENTITY", "id": "0fb25b34-6aaa-58a3-b621-4e468552d6de"},
        {"type": "IMPLEMENTATION", "id": "4f5d297c-2aca-5db9-b7ff-8af1e11287d6"}
      ]
    }
  ],
  "threats": [
    {"id": "2dbce4ac-5f74-58f6-81df-c46253d894c0", "alias": "Threat.DSQL.1"}
  ],
  "implementations": [
    {
      "id": "4f5d297c-2aca-5db9-b7ff-8af1e11287d6",
      "alias": "Implementation.DSQL.1",
      "behavior": "PREVENTIVE",
      "implementationType": "AWS::*::*::RESOURCE_POLICY",
      "implementationGuide": {
        "authorization_policy": {
          "governed_iam_permissions": [
            {"actions": ["dsql:*"], "resources": ["*"], "condition_keys": ["aws:PrincipalIsAWSService"]},
            {"actions": ["dsql:*"], "resources": ["*"], "condition_keys": ["aws:ResourceOrgID"]}
          ],
          "governed_resource_type": "AWS::EC2::VPCEndpoint"
        }
      },
      "implementationContext": [
        {
          "type": "SCOPING",
          "context": "Conditions dsql:* through the VPC endpoint on aws:ResourceOrgID.",
          "mitigationId": "6df5a224-53bf-5499-8fd8-ceb0e14e4928"
        },
        {
          "type": "REFERENCE",
          "context": "Use aws:ResourceOrgID, aws:ResourceOrgPaths, or aws:ResourceAccount.",
          "links": [
            {
              "href": "https://docs.aws.amazon.com/IAM/latest/UserGuide/access_policies_data-perimeters.html#access_policies_data-perimeters-resource",
              "title": "Establishing a resource perimeter"
            }
          ]
        }
      ],
      "mappings": [
        {"type": "MITIGATION", "id": "6df5a224-53bf-5499-8fd8-ceb0e14e4928"}
      ]
    },
    {
