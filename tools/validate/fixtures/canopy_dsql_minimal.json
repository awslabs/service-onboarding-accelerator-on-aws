      "alias": "Implementation.DSQL.Cluster.7",
      "behavior": "PREVENTIVE",
      "implementationType": "AWS::Organizations::Policy::DECLARATIVE_POLICY",
      "implementationGuide": {
        "declarative_policy": {
          "policy_type": "BACKUP_POLICY",
          "governed_attributes": [
            {"path": "$.plans.dsql_cluster_backup_plan.selections.resources.dsql_clusters.resource_types"}
          ]
        }
      },
      "implementationContext": [
        {"type": "SCOPING", "context": "Backup policy for DSQL clusters.", "mitigationId": "6df5a224-53bf-5499-8fd8-ceb0e14e4928"}
      ],
      "mappings": [
