    {
      "id": "8a5be3ca-71d9-5106-ae84-2c8b98e42a66",
      "alias": "Implementation.DSQL.Cluster.2",
      "behavior": "PROACTIVE",
      "implementationType": "AWS::CloudFormation::Type::HOOK",
      "implementationGuide": {
        "cloudformation_hook": {
          "governed_resource_properties": [
            {"resource_type": "AWS::DSQL::Cluster", "properties": [{"path": "$.PolicyDocument"}]}
          ]
        }
      },
      "implementationContext": [
        {"type": "SCOPING", "context": "Validates the cluster PolicyDocument at create/update time.", "mitigationId": "6df5a224-53bf-5499-8fd8-ceb0e14e4928"}
      ],
      "mappings": [
        {"type": "ENTITY", "id": "0fb25b34-6aaa-58a3-b621-4e468552d6de"},
