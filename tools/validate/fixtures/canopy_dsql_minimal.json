    {
      "id": "c3dcf9c1-bc5b-5cd4-915f-a5e973903730",
      "alias": "Implementation.DSQL.Cluster.3",
      "behavior": "DETECTIVE",
      "implementationType": "AWS::CloudTrail::Trail::MANAGEMENT_EVENT",
      "implementationGuide": {
        "cloudtrail_event": {
          "monitored_operations": [
            {"service": "dsql", "operation": "CreateCluster", "request_parameters": [{"path": "$.policy"}]},
            {"service": "dsql", "operation": "PutClusterPolicy", "request_parameters": [{"path": "$.policy"}]}
          ]
        }
      },
      "implementationContext": [
        {"type": "SCOPING", "context": "Flags CreateCluster and PutClusterPolicy calls.", "mitigationId": "6df5a224-53bf-5499-8fd8-ceb0e14e4928"},
        {
          "type": "DATA_PERIMETER",
          "context": "Monitor the $.policy request parameter.",
          "links": [
            {"href": "https://docs.aws.amazon.com/aurora-dsql/latest/APIReference/API_PutClusterPolicy.html", "title": "PutClusterPolicy API reference"}
          ]
        }
      ],
